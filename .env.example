# BookWorm Whisper Environment Configuration
# Copy this file to .env and fill in your values

# Kokoro TTS Configuration
OPENAI_BASE_URL=http://kokoro:8880/v1
OPENAI_API_KEY=fake

# Komga Configuration (optional - for reading progress sync)
KOMGA_URL=http://komga:25600
KOMGA_API_KEY=

# Audiobookshelf Configuration (optional - for reading progress sync)
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_API_KEY=

# Background sync interval in seconds (0 to disable)
GLOBAL_SYNC_TIME=300

# Timezone
TZ=Europe/London
