# BookWorm Whisper Environment Configuration
# Copy this file to .env and fill in your values

# Timezone
TZ=Europe/London

# Kokoro TTS Configuration
OPENAI_BASE_URL=http://kokoro:8880/v1
OPENAI_API_KEY=fake

# Ebook library backend: "komga" (default) or "grimmory"
EBOOK_LIBRARY=komga

# Komga Configuration (used when EBOOK_LIBRARY=komga)
KOMGA_URL=http://komga:25600
KOMGA_API_KEY=

# ---------------------------------------------------------------------------
# Grimmory Configuration (used when EBOOK_LIBRARY=grimmory)
# ---------------------------------------------------------------------------

# Grimmory app user credentials (used by bookworm-whisper to sync progress)
GRIMMORY_USERNAME=
GRIMMORY_PASSWORD=

# Grimmory container settings
APP_USER_ID=1000
APP_GROUP_ID=1000
BOOKLORE_PORT=6060

# Database connection string (JDBC format for Spring Boot)
DATABASE_URL=jdbc:mariadb://mariadb:3306/grimmory

# MariaDB settings
DB_USER=grimmory
DB_PASSWORD=changeme
DB_USER_ID=1000
DB_GROUP_ID=1000
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=grimmory

# ---------------------------------------------------------------------------

# Audiobookshelf Configuration (optional - for reading progress sync)
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_API_KEY=

# Background sync interval in seconds (0 to disable)
GLOBAL_SYNC_TIME=300
